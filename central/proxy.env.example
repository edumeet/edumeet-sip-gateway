# Copy to central/proxy.env (mode 600). Based on SIPMediaGW deploy/proxyAPI/.env.
# PROXY_TOKEN must be the same value as PROXY_TOKEN on every gateway host.
REDIS_HOST=redis
REDIS_PORT=6379

## API authentication
PROXY_TOKEN=
PROXY_ADMIN_TOKEN=

## Room-side resolution: leave empty to keep /gateway_id disabled
PROXY_ROOM_TOKEN=

## Pairing code attempts, per caller, before a 429. Zero disables the limit.
PROXY_CODE_TRY_LIMIT=10
PROXY_CODE_TRY_WINDOW=60
## Read X-Forwarded-For to tell callers apart. Only where a front end sets it:
## anyone can send that header.
PROXY_TRUST_FORWARDED=1

## The gateways are behind nginx with TLS, on their own hosts.
GW_API_SCHEME=https
