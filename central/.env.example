# Copy to central/.env. Docker Compose reads it for the values below.
SIPMEDIAGW_REPO=https://github.com/edumeet/edumeet-sipmediagw.git
SIPMEDIAGW_DIR=/root/sipmediagw
# prepare.sh: where the Kamailio and proxy images are loaded from (edumeet-sip-gateway/
# build_and_publish.sh on the build server).
IMAGES_URL=https://images.example.org/edumeet-sip
# firewall.sh (optional on the central host): the IPv4 addresses that can connect with SSH,
# separated by spaces.
SSH_SOURCES="192.0.2.10 192.0.2.11"
