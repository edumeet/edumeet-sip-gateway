# Copy to central/kamailio.env.
# The public IPv4 address of this host. LOCAL_IP is the address Kamailio listens on:
# the same address when the host has its public address on an interface.
PUBLIC_IP=203.0.113.10
LOCAL_IP=203.0.113.10
# Comma-separated SIP domains that are routed to the gateways.
SIP_DOMAIN=sip.example.org
# Empty: no SIP capture. Set the Homer address to send HEP.
HEPLIFY_SRV=
DEBUG_LEVEL=0
ANTIFLOOD=True
# True: only the addresses in the address table can call the gateways. See "Allowed room systems"
# in README.md.
IPAUTH=True
TLS=True
