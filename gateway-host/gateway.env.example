# Copy to /etc/edumeet-sip-gateway/gateway.env (mode 600) and fill in every value.

# Where install.sh clones SIPMediaGW from, and to.
SIPMEDIAGW_REPO=https://github.com/edumeet/edumeet-sipmediagw.git
SIPMEDIAGW_DIR=/root/sipmediagw
# Where install.sh loads the gateway image from (edumeet-sip-gateway/build_and_publish.sh on
# the build server).
IMAGES_URL=https://images.example.org/edumeet-sip

# The DNS name of this host (SIPMediaGW calls the variable HOST_IP). The central
# proxy sends the commands to https://HOST_IP:GW_API_PORT, to nginx on this host.
HOST_IP=node1.example.de.sip.example.org
GW_API_PORT=443
# HTTPLauncher, behind nginx. It must not listen on a public address: it has no
# authentication.
LAUNCHER_HOST=127.0.0.1
LAUNCHER_PORT=8100

# firewall.sh: the IPv4 addresses that can connect with SSH (separated by spaces), and the
# IPv4 address of the central host, the only address that can connect to port 443.
SSH_SOURCES="192.0.2.10 192.0.2.11"
CENTRAL_IP=203.0.113.10

# SIP user name prefix of the gateways on this host. It must be unique per host.
PREFIX=node1.example.de

# The eduMEET instances the gateways can join: gateway-host/webrtc_domains.json of this repository,
# so that update.sh applies its changes. Set this only for a list of your own.
#WEBRTC_DOMAINS_FILE=/etc/edumeet-sip-gateway/webrtc_domains.json

# Kamailio on the central host. The gateways register with SIP over TLS, so this
# is the DNS name in the certificate of the central host.
SIP_REGISTRAR=sip.example.org
SIP_SECRET=change-me
GW_NAME_PREFIX=mediagw

# The central host, through its nginx: registration with the proxy, the gateway
# assets (connector, logo), and the address in the QR code on the room screen.
GW_PROXY=https://sip.example.org
GW_REVERSE_PROXY=https://sip.example.org
ASSETS_URL=https://sip.example.org/assets/assets.tar.xz
PROXY_TOKEN=change-me

# TURN on a media node near this host: its public IPv4 address and the
# gateway-only shared secret configured in that node's coturn.
TURN_SRV=198.51.100.20
GATEWAY_TURN_SECRET=change-me

# More baresip logs, for debugging: " -s" logs every SIP message (with the SRTP keys of the calls),
# " -s -v" also all debug output.
#BARESIP_ARGS=" -s"

TZ=Europe/Warsaw
