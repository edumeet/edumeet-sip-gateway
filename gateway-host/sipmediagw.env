# Derived from SIPMediaGW .env (Apache-2.0). Changes: WEBRTC_DOMAINS (install.sh puts the
# content of WEBRTC_DOMAINS_FILE here), HEPLIFY_SRV (off by default), MEDIAENC (H.264 only),
# SIP_PROTOCOL (tls), SIP_PROXY (empty: baresip.sh would set TCP for an outbound proxy) and
# IVR_DIGIT_LENGTH (1: eduMEET meeting names can be shorter than 5 characters) and IVR_TIMEOUT
# (300: a call without a meeting gives its gateway back after 5 minutes; the room screen counts down)
# and QR_CODE_URL (the pairing page: nginx does not serve the portal page) and DOCKER_IMAGE (the
# image from the build server, loaded by install.sh).
DOCKER_IMAGE=edumeet-sip-gateway:local
MAIN_APP=${MAIN_APP:-baresip} # baresip, streaming, recording

CPU_PER_GW=4 # Number of CPU cores per gateway:
               # VID_SIZE_WEBRTC=640x360 => 2.5
               # VID_SIZE_WEBRTC=1280x720 => 4


GW_NAME=${GW_NAME}
HOST_IP=${HOST_IP}
GW_ID=${ID}
TZ=${TZ:-$HOST_TZ}
INIT=${INIT} # Initialize the gateway (create config files)

## Media
WITH_ALSA=${WITH_ALSA:-true}
PULSE_SERVER=${PULSE_SERVER}
AUDIO_ONLY=${AUDIO_ONLY:-}
DUAL_SCREEN_LAYOUT=${DUAL_SCREEN_LAYOUT:-false}
DISPLAY=${DISPLAY}
DISPLAY_WEB=${DISPLAY:-:99}
DISPLAY_APP=:100

VID_SIZE_APP=1280x720 # 720p resolution at least to support screen sharing
VID_SIZE_WEBRTC=640x360
VID_SIZE_SLIDE=1280x720

## Webconference
ROOM_NAME=${ROOM}
PHYSICAL_ROOM=${PHYSICAL_ROOM:-}
USER_NAME=${USER}
BROWSING=${BROWSING:-}
WEBRTC_DOMAINS='@WEBRTC_DOMAINS@'
CONFMAPPER=${CONFMAPPER:-} # https://api.jitsi.net/conferenceMapper?id
ENDING_TIMEOUT=${ENDING_TIMEOUT:-} # Time (seconds) to wait before leaving if no others participants.

## Baresip
BARESIP_ARGS=${BARESIP_ARGS:-} # More logs: set BARESIP_ARGS in gateway.env
SIP_PROTOCOL=tls # udp, tcp or tls
SIP_NAME_PREFIX=${PREFIX}
CHECK_REGISTER=${CHECK_REG}

# SIP registrar IPv4 address:
SIP_REGISTRAR=${SIP_REGISTRAR:-$HOST_IP}
# SIP outbound proxy IPv4 address:
SIP_PROXY=
# TURN server IPv4 address:
TURN_SRV=${TURN_SRV:-$HOST_IP}
# Heplify server IPv4 address:
HEPLIFY_SRV=${HEPLIFY_SRV:-}
# HTTP URL where to push the call history at the end of each call, for
# instance the Manager: http://<manager>:8200/ingest/calls (see manager/README.md)
LOG_PUSH_URL=
# Optional bearer token sent with the push; leave empty to send none
# (the Manager's INGEST_TOKEN)
LOG_PUSH_TOKEN=

# How often the gateway reads its own media counters during a call, in
# seconds. Zero turns the sampling off.
MEDIA_STATS_INTERVAL=${MEDIA_STATS_INTERVAL:-10}

# WebRTC statistics of the call browser streamed to an rtcstats server
# (https://github.com/rtcstats/rtcstats). One dump per call frame using WebRTC.
RTCSTATS_ENABLED=${RTCSTATS_ENABLED:-false}
# ws:// or wss:// URL; append ?rtcstats-token=<jwt> if the server requires one.
# The gateway adds gw, room and browsing to the query.
RTCSTATS_SERVER_URL=${RTCSTATS_SERVER_URL:-}

MEDIAENC=srtp;video_codecs=h264;audio_codecs=G722/16000/1,PCMU,PCMA # srtp, srtp-mand, srtp-mandf, dtls_srtp or zrtp; video_codecs=h264 avoids H.265 negotiation failures; audio_codecs without opus: a room system that switches to Opus during the call is heard at half speed; G722 with /16000/1, without a rate baresip looks for 8000 Hz and leaves G722 out
BFCP_FLOORCTRL=c-only

## IVR
IVR_LANG=${IVR_LANG:-en} # Language for IVR prompts (e.g. "fr", "en", "es")
IVR_DIGIT_LENGTH=${IVR_DIGIT_LENGTH:-1} # Min length of digits to enter IVR menu
IVR_TTS=true #${IVR_TTS:-}
IVR_TIMEOUT=${IVR_TIMEOUT:-300} # IVR timeout in seconds
ASSETS_URL=${ASSETS_URL:-} # e.g. http://.../assets.tar.xz

## Authentication
AUTH_TOKEN=${AUTH_TOKEN:-} # JWT token for authentication
TOKEN_API_URL=${TOKEN_API_URL:-} # URL to get the JWT token
ROOM_REGEXP=${ROOM_REGEXP:-} # Regular expression to match room names
WEBINAIRE_TOKEN=${WEBINAIRE_TOKEN:-} # JWT token for authentication

## API
GW_API_PORT=${GW_API_PORT:-8100} # Port for the HTTPLauncher
GW_PROXY=${GW_PROXY:-http://$HOST_IP:9000}
GW_PROXY_REG_TIMEOUT=${GW_PROXY_REG_TIMEOUT:-30}
GW_REVERSE_PROXY=${GW_REVERSE_PROXY:-http://$HOST_IP:9000}
PROXY_TOKEN=${PROXY_TOKEN:-1234}

QR_CODE_URL="{reverse_proxy}/pairing?pairingCode={code}"
PAIRING_CODE_TIMEOUT=${PAIRING_CODE_TIMEOUT:-90} # Should be a multiple of GW_PROXY_REG_TIMEOUT

## Streaming
RTMP_DST_URI=${RTMP_DST}

##HTTP PROXY
HTTPS_PROXY=${HTTPS_PROXY:-}
HTTP_PROXY=${HTTP_PROXY:-}
NO_PROXY=${NO_PROXY:-}

## Recording
FS_API_KEY=${FS_API_KEY}
FS_USER_MAIL=${FS_USER_MAIL}
FS_RECIPIENT_MAIL=${FS_RECIPIENT_MAIL}
RECORD_MAX_TIME=${RECORD_MAX_TIME:-10800} # in seconds
SEGMENT_TIME=${SEGMENT_TIME:-60} # in seconds
WITH_TRANSCRIPT=${WITH_TRANSCRIPT}
TRANSCRIPT_SRV=${TRANSCRIPT_SRV:-transcript$ID:8888}

