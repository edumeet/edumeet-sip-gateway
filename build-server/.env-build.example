# Copy to .env-build next to build_and_publish.sh on the build server.

# The directory of the web server that the hosts load the images from (IMAGES_URL in central/.env
# and gateway.env). The script writes only the edumeet-sip-* tar files and current_sip_version.txt
# there.
DEST_DIR=/var/www/html/images/edumeet-sip

# Optional: this repository and the branch whose SIPMEDIAGW_VERSION is built, and the SIPMediaGW
# fork that has that tag. These are the defaults.
#DEPLOY_REPO=https://github.com/edumeet/edumeet-sip-gateway.git
#BRANCH_SIP_GATEWAY=main
#SIPMEDIAGW_REPO=https://github.com/edumeet/edumeet-sipmediagw.git
